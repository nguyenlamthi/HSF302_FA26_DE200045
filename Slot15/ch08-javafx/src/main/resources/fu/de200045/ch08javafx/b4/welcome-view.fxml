<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fu.de200045.ch08javafx.b4.WelcomeController"
      alignment="CENTER" spacing="16" prefWidth="360" prefHeight="200"
      style="-fx-background-color: #f0f4f8; -fx-font-family: 'Segoe UI';">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label fx:id="lblWelcome" text="Xin chào!"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>

    <Button text="Đăng xuất" onAction="#handleLogout"
            style="-fx-background-color: #d93025; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 5; -fx-cursor: hand;"/>
</VBox>